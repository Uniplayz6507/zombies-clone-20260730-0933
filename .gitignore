# ---------------------------------------------------------------
# 3D / game asset artifacts
# ---------------------------------------------------------------
# Large source art is NOT committed. Only optimized, licensed,
# redistributable assets belong in public/assets (see ASSETS.md).
#
# Uncompressed / DCC source files:
*.blend
*.blend1
*.blend2
*.max
*.ma
*.mb
*.c4d
*.zpr
*.ztl
*.psd
*.xcf
*.substance
*.sbs
*.sbsar

# Raw captures & huge intermediates
*.fbx
*.obj
*.mtl
*.exr
*.tif
*.tiff

# Baked/generated caches produced at build time
public/assets/**/*.ktx2.cache
*.drc.tmp

# Local-only asset drop folder (optional CC0 upgrades, see ASSETS.md)
public/assets/local/
